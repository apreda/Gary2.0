{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "crons": [
    {
      "path": "/api/cron/email/daily",
      "schedule": "30 0-4,16-23 * * *"
    },
    {
      "path": "/api/cron/email/weekly",
      "schedule": "0 18,20,22 * * 0"
    }
  ]
}
