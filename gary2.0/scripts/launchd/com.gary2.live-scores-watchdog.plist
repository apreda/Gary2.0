<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gary2.live-scores-watchdog</string>

    <!-- Defense-in-depth for the live-scores poller (com.gary2.live-scores). That
         job is a fire-and-exit StartInterval=120 job, but on Jun 21 2026 it silently
         stopped firing (launchd decoupled the StartInterval after a laptop-sleep
         event) and did NOT resume for 10 days — so in-progress games showed their
         scheduled start times instead of live scores (no live_scores rows were
         written). A fire-and-exit job has no process to pgrep, so this watchdog uses
         a FRESHNESS signal instead: the poller logs every run, so if its log has not
         been touched in >8 min (4 missed 120s cycles) the job is stuck. Recovery is
         a full reload (bootout + bootstrap + kickstart) — a bare kickstart does NOT
         reset the decoupled StartInterval; the reload is what revived it by hand on
         Jul 1. The poll is an idempotent upsert, so a redundant run is safe. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>LOG=/Users/adam.preda/Library/Logs/Gary2.0/live-scores-launchd.log; WLOG=/Users/adam.preda/Library/Logs/Gary2.0/live-scores-watchdog.log; U=$(/usr/bin/id -u); PLIST=/Users/adam.preda/Library/LaunchAgents/com.gary2.live-scores.plist; NOW=$(/bin/date +%s); MT=$([ -f "$LOG" ] &amp;&amp; /usr/bin/stat -f %m "$LOG" || echo 0); if [ $((NOW - MT)) -gt 480 ]; then echo "$(/bin/date '+%Y-%m-%d %H:%M:%S') live-scores STALE (log age $((NOW - MT))s) — reloading job" >> "$WLOG"; /bin/launchctl bootout "gui/$U/com.gary2.live-scores" 2>/dev/null; /bin/launchctl bootstrap "gui/$U" "$PLIST" 2>/dev/null; /bin/launchctl kickstart -k "gui/$U/com.gary2.live-scores"; fi</string>
    </array>

    <key>StartInterval</key>
    <integer>120</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/adam.preda/Library/Logs/Gary2.0/live-scores-watchdog-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/adam.preda/Library/Logs/Gary2.0/live-scores-watchdog-stderr.log</string>
</dict>
</plist>
