{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "src/contracts/**/*.d.ts",
    "src/services/bdlResponse.js",
    "src/services/marketTruth.js",
    "src/services/pickdesk/ticketIdentity.js",
    "scripts/lib/picks/calendar.js",
    "tests/types/**/*.ts"
  ]
}
